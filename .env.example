# BeaconOps Configuration
PORT=3000
NODE_ENV=development

# Default account (matches seed data — override with your own UUID if needed)
DEFAULT_ACCOUNT_ID=00000000-0000-0000-0000-000000000001

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Stripe (all three products)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# LLM Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# ElevenLabs (TTS/Voice)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_CHRONOSTATES=voice-id-for-chronostates
ELEVENLABS_VOICE_PAYROLL=voice-id-for-payroll
ELEVENLABS_VOICE_BUDGETING=voice-id-for-budgeting

# Gmail API
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN_CHRONOSTATES=refresh-token
GMAIL_REFRESH_TOKEN_PAYROLL=refresh-token
GMAIL_REFRESH_TOKEN_BUDGETING=refresh-token

# Social Platform APIs
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REFRESH_TOKEN=your-reddit-refresh-token

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_PAGE_TOKEN_CHRONOSTATES=page-token
FACEBOOK_PAGE_TOKEN_PAYROLL=page-token
FACEBOOK_PAGE_TOKEN_BUDGETING=page-token

DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHRONOSTATES_SERVER_ID=server-id

INSTAGRAM_ACCESS_TOKEN_CHRONOSTATES=ig-token
INSTAGRAM_ACCESS_TOKEN_PAYROLL=ig-token
INSTAGRAM_ACCESS_TOKEN_BUDGETING=ig-token

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
YOUTUBE_API_KEY=your-youtube-api-key

# Substack
SUBSTACK_API_KEY=your-substack-api-key
SUBSTACK_PUBLICATION_ID=your-publication-id

# Lead Data Provider (choose one: salesnavhunter or apollo)
LEAD_DATA_PROVIDER=apollo
HUNTER_API_KEY=your-hunter-api-key
APOLLO_API_KEY=your-apollo-api-key
NEVERBOUNCE_API_KEY=your-neverbounce-api-key

# Outreach Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Image Generation
IMAGE_GEN_API_KEY=your-image-gen-api-key
IMAGE_GEN_PROVIDER=openai

# Notifications
NOTIFICATION_PUSH_ENDPOINT=https://your-push-service.com/send
NOTIFICATION_EMAIL=your-email@example.com

# Base URLs
BASE_URL=http://localhost:3000
CHRONOSTATES_URL=https://chronostates.io
PAYROLL_BEACON_URL=https://payrollbeacon.com
BUDGETING_BEACON_URL=https://budgetingbeacon.com
